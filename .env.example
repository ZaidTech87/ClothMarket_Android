# ClothMarket Android app - environment configuration template
#
# These are read by app.config.js at build/start time (see
# process.env.API_BASE_URL / process.env.WS_BASE_URL there) and exposed
# to the app at runtime via src/config/env.js. Copy this file to `.env`
# and fill in real values, or export them in your shell/CI before
# running `expo start` / `eas build`.
#
# IMPORTANT: this file intentionally contains no real secrets. Nothing
# in this Android app should ever hold backend credentials (DB password,
# JWT signing secret, Groq API key, Cloudinary secret, Sightengine
# secret) - all of those stay server-side only, exactly as in the
# existing web app.

# Base URL of the existing Spring Boot backend's REST API, including its
# /api context path. No trailing slash.
# Example (your current deployed backend):
API_BASE_URL=https://fix-cloth-marketplace-1.onrender.com/api

# Optional. STOMP WebSocket endpoint. If unset, the app derives it as
# `${API_BASE_URL}/ws` (see src/config/env.js), which is correct for the
# existing backend's WebSocketConfig - you only need to set this
# explicitly if your WS endpoint lives somewhere different from your
# REST API.
# WS_BASE_URL=https://fix-cloth-marketplace-1.onrender.com/api/ws
